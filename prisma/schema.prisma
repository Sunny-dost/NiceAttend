// NiceAttend — Database Schema (Prisma ORM)
// Target Engine: PostgreSQL 16 (Neon Serverless)

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  PRINCIPAL
  VICE_PRINCIPAL
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
}

enum AttendanceMethod {
  QR_SCAN
  MANUAL
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  username     String   @unique @db.VarChar(50)
  email        String   @unique @db.VarChar(100)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  fullName     String   @map("full_name") @db.VarChar(100)
  role         Role
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  recordedAttendance AttendanceRecord[]
  auditLogs          AttendanceAuditLog[]

  @@map("users")
}

model Class {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @unique @db.VarChar(50)
  displayOrder Int       @default(0) @map("display_order")
  createdAt    DateTime  @default(now()) @map("created_at")

  sections     Section[]
  students     Student[]

  @@map("classes")
}

model Section {
  id        String   @id @default(uuid()) @db.Uuid
  classId   String   @map("class_id") @db.Uuid
  name      String   @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")

  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  students  Student[]

  @@unique([classId, name])
  @@map("sections")
}

model Student {
  id            String   @id @default(uuid()) @db.Uuid
  studentCode   String   @unique @map("student_code") @db.VarChar(30)
  fullName      String   @map("full_name") @db.VarChar(100)
  classId       String   @map("class_id") @db.Uuid
  sectionId     String   @map("section_id") @db.Uuid
  qrToken       String   @unique @map("qr_token") @db.VarChar(64)
  guardianPhone String?  @map("guardian_phone") @db.VarChar(25)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  class         Class    @relation(fields: [classId], references: [id], onDelete: Restrict)
  section       Section  @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  attendanceRecords AttendanceRecord[]

  @@index([studentCode])
  @@index([qrToken])
  @@index([isActive])
  @@map("students")
}

model AttendanceRecord {
  id               String           @id @default(uuid()) @db.Uuid
  studentId        String           @map("student_id") @db.Uuid
  attendanceDate   DateTime         @map("attendance_date") @db.Date
  status           AttendanceStatus
  scanTime         DateTime?        @map("scan_time")
  recordedByUserId String           @map("recorded_by") @db.Uuid
  method           AttendanceMethod
  notes            String?          @db.Text
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  student          Student          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  recordedBy       User             @relation(fields: [recordedByUserId], references: [id], onDelete: Restrict)
  auditLogs        AttendanceAuditLog[]

  @@unique([studentId, attendanceDate])
  @@index([studentId])
  @@index([attendanceDate])
  @@map("attendance_records")
}

model AttendanceAuditLog {
  id                 String           @id @default(uuid()) @db.Uuid
  attendanceRecordId String           @map("attendance_record_id") @db.Uuid
  changedByUserId    String           @map("changed_by") @db.Uuid
  previousStatus     String           @map("previous_status") @db.VarChar(20)
  newStatus          String           @map("new_status") @db.VarChar(20)
  reason             String?          @db.Text
  createdAt          DateTime         @default(now()) @map("created_at")

  attendanceRecord   AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  changedBy          User             @relation(fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([attendanceRecordId])
  @@map("attendance_audit_logs")
}
